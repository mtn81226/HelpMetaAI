{
  "name": "WF04 - Team Assignment",
  "nodes": [
    {
      "id": "e379085e-469a-49aa-b071-4d9e12cb9caa",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "parameters": {
        "httpMethod": "POST",
        "path": "team-assignment",
        "responseMode": "responseNode",
        "options": {}
      },
      "position": [
        0,
        0
      ],
      "webhookId": "d951eeed-ff14-4b57-9d9f-31cdf78cdda3"
    },
    {
      "id": "3b5280f8-1476-4070-bfd8-a2e87fcb1319",
      "name": "Normalize Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const payload = $json.body && typeof $json.body === 'object' ? { ...$json.body, ...$json } : $json;\nreturn [{ json: { ...payload, title: String(payload.title ?? '').trim(), description: String(payload.description ?? '').trim() } }];"
      },
      "position": [
        240,
        0
      ]
    },
    {
      "id": "5d6cfa2c-96ce-404f-b706-8f548ff45603",
      "name": "Validate Required Fields",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.title }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "position": [
        480,
        0
      ]
    },
    {
      "id": "78562896-0dde-4749-a87b-0ec794bdc39e",
      "name": "Normalize Ticket Metadata",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "return [{ json: { ...$json, ticketId: String($json.ticketId ?? ('TCK-' + Date.now())), status: String($json.status ?? 'Open'), workflowTrace: Array.isArray($json.workflowTrace) ? $json.workflowTrace : [], stepTrace: Array.isArray($json.stepTrace) ? $json.stepTrace : [] } }];"
      },
      "position": [
        720,
        0
      ]
    },
    {
      "id": "5e394e1f-bc28-4cd6-ae50-3b6951008c62",
      "name": "Normalize Category",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const allowed=['Network','Hardware','Software','Account & Access','Security','Other']; const category=allowed.includes($json.category)?$json.category:'Other'; return [{ json: { ...$json, category } }];"
      },
      "position": [
        960,
        0
      ]
    },
    {
      "id": "e0547397-b634-49b8-92c8-6d80a2cfde16",
      "name": "Select Support Team",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const text = (($json.title || '') + ' ' + ($json.description || '')).toLowerCase();\nconst category = $json.category || 'Other';\nconst priority = $json.priority || 'Medium';\nconst isVip = /vip|ban giám đốc|hội đồng quản trị|phòng họp tổng giám đốc|boardroom|ceo|director/i.test(text);\n\nconst baseTeams = {\n  Network: 'Network Support',\n  Hardware: 'Hardware Support',\n  Software: 'Software Support',\n  'Account & Access': 'Identity and Access Support',\n  Security: 'Security Operations',\n  Other: 'IT General'\n};\n\nlet team = $json.assignedTeam || baseTeams[category] || baseTeams.Other;\nlet queue = '';\n\nif (isVip) {\n  team = 'Executive VIP Support Taskforce';\n  queue = 'queue-executive-fasttrack';\n} else if (priority === 'Critical' || priority === 'High') {\n  if (category === 'Security') team = 'Security Operations (Tier 2 Incident Response)';\n  else if (category === 'Network' || category === 'Hardware') team = 'Infrastructure Operations (Tier 2)';\n  else team = 'Senior IT Support Team';\n  const slug = category === 'Account & Access' ? 'access' : category.toLowerCase().replace(/[^a-z]/g, '');\n  queue = 'queue-' + slug + '-escalated';\n} else {\n  const slug = category === 'Account & Access' ? 'access' : category.toLowerCase().replace(/[^a-z]/g, '');\n  queue = 'queue-' + slug;\n}\n\nreturn [{ json: { ...$json, assignedTeam: team, assignmentQueue: queue, isVipRequest: isVip } }];"
      },
      "position": [
        1200,
        0
      ]
    },
    {
      "id": "e5ec5834-a8df-4cd3-b0c6-d46ed44adda5",
      "name": "Set Assignment Policy",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "parameters": {
        "keepOnlySet": false,
        "values": {
          "string": [
            {
              "name": "routingPolicy",
              "value": "tier-based"
            },
            {
              "name": "routingTier",
              "value": "={{ $json.priority === \"Critical\" || $json.priority === \"High\" ? \"Tier-2\" : \"Tier-1\" }}"
            }
          ]
        },
        "options": {}
      },
      "position": [
        1440,
        0
      ]
    },
    {
      "id": "56a545fc-0d1d-4e37-9272-2e37cc2f71ac",
      "name": "Set Assignment Reason",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const priority = $json.priority || 'Medium';\nlet reason = '';\nif ($json.isVipRequest) {\n  reason = 'Fast-tracked for Executive/VIP stakeholder priority';\n} else if (priority === 'Critical' || priority === 'High') {\n  reason = 'Routed by category: ' + ($json.category || 'Other') + ' (Escalated tier for ' + priority + ' priority)';\n} else {\n  reason = 'Routed by category: ' + ($json.category || 'Other') + ' (Standard L1 queue)';\n}\nreturn [{ json: { ...$json, assignmentReason: reason } }];"
      },
      "position": [
        1680,
        0
      ]
    },
    {
      "id": "06ae163b-235b-41b4-8ddd-4e9d1c27bd82",
      "name": "Check Assignment Completeness",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.assignedTeam }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "position": [
        1920,
        0
      ]
    },
    {
      "id": "264c931a-7e4e-4e22-b12c-aaf67dd43442",
      "name": "Append Workflow Trace",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const workflowId = $workflow.name.match(/^WF\\d+/)?.[0] ?? 'WF';\nreturn [{ json: { ...$json, workflowTrace: [...new Set([...($json.workflowTrace ?? []), workflowId])], stepTrace: [...($json.stepTrace ?? []), 'workflow-complete'] } }];"
      },
      "position": [
        2160,
        0
      ]
    },
    {
      "id": "660c4526-3d45-4cf3-895f-5b066e982141",
      "name": "Build Result Envelope",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "return [{ json: { ...$json, workflowResult: { workflow: $workflow.name, ticketId: $json.ticketId, processedAt: new Date().toISOString(), success: true } } }];"
      },
      "position": [
        2400,
        0
      ]
    },
    {
